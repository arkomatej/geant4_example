# Cleaned and Optimized vis.mac for VRML2FILE and Particle Tracks

# Specify the VRML file driver
/vis/open VRML2FILE

# Disable auto refresh and quieten vis messages whilst scene is established
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw geometry:
/vis/drawVolume

# Specify view angle (Adjusted to give a good 3D isometric view)
/vis/viewer/set/viewpointThetaPhi 120 150

# Specify style (wireframe helps see tracks inside the solid slab)
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100

# ----------------------------------------------------------------------
# CRITICAL: Explicitly turn on trajectory storage so tracks are saved!
/tracking/storeTrajectory 2
# ----------------------------------------------------------------------

# Draw smooth trajectories at end of event:
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2

# Superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate

# Axes and scale (3D objects, safe for VRML)
/vis/scene/add/scale 1 mm
/vis/scene/add/axes 0 0 0 1 mm

# Make the "World" box invisible so you can see the InGaAs slab
/vis/geometry/set/visibility World 0 false

# Re-establish auto refreshing and verbosity:
/vis/viewer/set/autoRefresh true
/vis/verbose warnings

# Note: /vis/viewer/flush is INTENTIONALLY left out here!
# You must run it manually after shooting the beam.